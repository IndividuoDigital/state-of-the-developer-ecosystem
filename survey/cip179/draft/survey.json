            "fr": "Aucun"
          }
        },
        {
          "type": "checkbox",
          "name": "testing",
          "title": {
            "default": "How have you tested your Cardano code in the last 12 months?",
            "fr": "Comment avez-vous testé votre code Cardano au cours des 12 derniers mois\u00a0?"
          },
          "choices": [
            { "value": "unit", "text": { "default": "Unit tests of validators", "fr": "Tests unitaires des validateurs" } },
            { "value": "property", "text": { "default": "Property-based tests or fuzzing", "fr": "Tests basés sur les propriétés ou fuzzing" } },
            { "value": "emulator", "text": { "default": "Emulator, no node (Lucid Evolution, Scalus, sc-tools…)", "fr": "Émulateur, sans nœud (Lucid Evolution, Scalus, sc-tools…)" } },
            { "value": "devnet", "text": { "default": "Local devnet (Yaci DevKit, cardano-testnet…)", "fr": "Devnet local (Yaci DevKit, cardano-testnet…)" } },
            { "value": "testnet", "text": { "default": "Public testnet (Preview, Preprod)", "fr": "Testnet public (Preview, Preprod)" } },
