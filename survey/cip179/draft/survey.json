{
  "title": "Cardano Developer Survey 2026",
  "description": "About 10 minutes. Only the first question is required: skip any other. The results tell tool builders, documentation writers and funders what to work on first.",
  "triggers": [{ "type": "complete", "expression": "{experience} = 'not-a-developer'" }],
  "pages": [
    {
      "name": "what_you_build",
      "elements": [
        {
          "type": "radiogroup",
          "name": "experience",
          "title": "How long have you been writing or deploying software?",
          "isRequired": true,
          "choices": [
            { "value": "not-a-developer", "text": "I don't write or deploy software" },
            { "value": "under-2", "text": "Less than 2 years" },
            { "value": "2-4", "text": "2 to 4 years" },
            { "value": "5-9", "text": "5 to 9 years" },
            { "value": "10-plus", "text": "10 years or more" }
          ]
        },
        {
          "type": "checkbox",
          "name": "building",
          "title": "What are you building on Cardano?",
          "description": "Choose up to 4.",
          "maxSelectedChoices": 4,
          "choices": [
            { "value": "ai-agents", "text": "AI agents" },
            { "value": "bridges", "text": "Bridges and interoperability" },
            { "value": "defi", "text": "DeFi" },
            { "value": "dev-tools", "text": "Developer tools and infrastructure" },
            { "value": "education", "text": "Education and community" },
            { "value": "gaming", "text": "Gaming" },
            { "value": "governance", "text": "Governance tools" },
            { "value": "identity", "text": "Identity" },
            { "value": "layer-2", "text": "Layer 2s and scaling" },
            { "value": "nfts", "text": "NFTs" },
            { "value": "oracles", "text": "Oracles and data" },
            { "value": "payments", "text": "Payments and stablecoins" },
            { "value": "privacy", "text": "Privacy and zero-knowledge" },
            { "value": "real-world-assets", "text": "Real-world assets" },
            { "value": "staking", "text": "Staking and SPO tools" },
            { "value": "wallets", "text": "Wallets" },
            { "value": "other", "text": "Other" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "stage",
          "title": "How far along is your main Cardano project?",
          "choices": [
            { "value": "learning", "text": "Learning or experimenting" },
            { "value": "development", "text": "In development (testnet)" },
            { "value": "released", "text": "Released (mainnet, or a published tool)" },
            { "value": "users", "text": "Released, with regular users" }
          ]
        },
        {
          "type": "text",
          "name": "project_link",
          "visibleIf": "{stage} anyof ['released', 'users']",
          "title": "Where can we find this project (website or repository link)?",
          "description": "This link is public and ties all your answers to this project."
        },
        {
          "type": "radiogroup",
          "name": "started",
          "title": "When did you start building on Cardano?",
          "choices": [
            "2026",
            "2025",
            { "value": "2023-2024", "text": "2023–2024" },
            { "value": "2021-2022", "text": "2021–2022" },
            { "value": "2020-or-earlier", "text": "2020 or earlier" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "weekly_hours",
          "title": "In a typical week, how much time do you spend building on Cardano?",
          "choices": [
            { "value": "under-5", "text": "Less than 5 hours" },
            { "value": "5-19", "text": "5 to 19 hours" },
            { "value": "20-34", "text": "20 to 34 hours" },
            { "value": "35-plus", "text": "35 hours or more" }
          ]
        }
      ]
    },
    {
      "name": "how_it_is_going",
      "elements": [
        {
          "type": "radiogroup",
          "name": "satisfaction",
          "title": "Overall, how satisfied are you with building on Cardano?",
          "choices": [
            { "value": "very-satisfied", "text": "Very satisfied" },
            { "value": "satisfied", "text": "Satisfied" },
            { "value": "neutral", "text": "Neither satisfied nor dissatisfied" },
            { "value": "dissatisfied", "text": "Dissatisfied" },
            { "value": "very-dissatisfied", "text": "Very dissatisfied" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "trend",
          "title": "Compared with a year ago, building on Cardano is:",
          "choices": [
            { "value": "much-easier", "text": "Much easier" },
            { "value": "easier", "text": "Somewhat easier" },
            { "value": "same", "text": "About the same" },
            { "value": "harder", "text": "Somewhat harder" },
            { "value": "much-harder", "text": "Much harder" },
            { "value": "new", "text": "I wasn't building on Cardano a year ago" }
          ]
        },
        {
          "type": "comment",
          "name": "best",
          "title": "What is the best thing about building on Cardano?"
        },
        {
          "type": "comment",
          "name": "most_painful",
          "title": "What is the most painful thing about building on Cardano?"
        }
      ]
    },
    {
      "name": "what_you_build_with",
      "elements": [
        {
          "type": "checkbox",
          "name": "onchain_languages",
          "title": "Which languages have you used for on-chain code in the last 12 months?",
          "choices": [
            "Aiken",
            "Helios",
            "JuLC",
            "Marlowe",
            "OpShin",
            "Pebble",
            "Plinth (Plutus-Tx)",
            "Plu-ts",
            "Plutarch",
            "Scalus",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true,
          "noneText": "None, I don't write on-chain code"
        },
        {
          "type": "checkbox",
          "name": "onchain_libraries",
          "title": "Which on-chain libraries have you used in the last 12 months?",
          "description": "Not counting standard libraries.",
          "choices": [
            "Aicone, with Sundae multisig (Aiken)",
            "ak-381 (Aiken)",
            "Assist (Aiken)",
            "Design Patterns (Aiken)",
            "Fuzz (Aiken)",
            "Merkle Patricia Forestry (Aiken)",
            "Oakshield (Aiken)",
            "Vodka (Aiken)",
            "ZeroJ (JuLC)",
            "plutus-script-utils (Plinth)",
            "Plutus Simple Model (Plinth)",
            "catalyst-onchain-libs (Plutarch)",
            "Liqwid libs (Plutarch)",
            "Ply (Plutarch)",
            "Design Patterns (Scalus)",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "checkbox",
          "name": "offchain_libraries",
          "title": "Which off-chain libraries have you used in the last 12 months?",
          "choices": [
            "Chrysalis (.NET)",
            "elm-cardano (Elm)",
            "Apollo (Go)",
            "gOuroboros (Go)",
            "Atlas (Haskell)",
            "cardano-api (Haskell)",
            "sc-tools (Haskell)",
            "cardano-client-lib (Java)",
            "Yaci (Java)",
            "cardano-transaction-lib (PureScript)",
            "PyCardano (Python)",
            "Pallas (Rust)",
            "CML, cardano-multiplatform-lib (Rust, JS)",
            "CSL, cardano-serialization-lib (Rust, JS)",
            "Scalus (Scala)",
            "Tx3",
            "Blaze (TypeScript)",
            "Cardano JS SDK (TypeScript)",
            "Cometa (TypeScript)",
            "Dexter (TypeScript)",
            "Evolution SDK (TypeScript)",
            "Lucid (TypeScript)",
            "Mesh (TypeScript)",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "checkbox",
          "name": "self_hosted",
          "title": "Which of these have you run yourself in the last 12 months, locally or on your servers?",
          "choices": [
            "Adder",
            "Amaru",
            "Blockfrost",
            "cardano-db-sync",
            "cardano-graphql",
            "cardano-node",
            "cardano-wallet",
            "Dingo",
            "Dolos",
            "Gummiworm",
            "Hydra",
            "Kupo",
            "Mithril",
            "Ogmios",
            "Oura",
            "Scrolls",
            "Yaci DevKit",
            "Yaci Store",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "checkbox",
          "name": "dev_tools",
          "title": "Which developer tools have you used in the last 12 months?",
          "description": "Including stake pool tools.",
          "choices": [
            "bech32",
            "Cardano Dev Wallet",
            "cardano-addresses",
            "cardano-cli",
            "cardano-hw-cli",
            "cardano-signer",
            "cardano-up",
            "cncli",
            "Cquisitor",
            "CShell",
