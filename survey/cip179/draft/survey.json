    {
      "name": "what_gets_in_the_way",
      "elements": [
        {
          "type": "matrix",
          "name": "problems",
          "title": {
            "default": "How much of a problem is each of these for you?",
            "fr": "Dans quelle mesure chacun de ces points vous pose-t-il problème\u00a0?"
          },
          "columns": [
            { "value": "big", "text": { "default": "Big problem", "fr": "Gros problème" } },
            { "value": "could-be-better", "text": { "default": "Could be better", "fr": "Pourrait être mieux" } },
            { "value": "good", "text": { "default": "All good", "fr": "Tout va bien" } },
            { "value": "not-relevant", "text": { "default": "Not relevant", "fr": "Non pertinent" } }
          ],
          "rows": [
            { "value": "first-app", "text": { "default": "Getting a first application working end to end", "fr": "Faire fonctionner une première application de bout en bout" } },
            { "value": "choosing-tools", "text": { "default": "Knowing which tools and libraries to choose", "fr": "Savoir quels outils et bibliothèques choisir" } },
            { "value": "documentation", "text": { "default": "Finding up-to-date documentation", "fr": "Trouver une documentation à jour" } },
            { "value": "examples", "text": { "default": "Finding working examples", "fr": "Trouver des exemples qui fonctionnent" } },
            { "value": "help", "text": { "default": "Getting help when I am stuck", "fr": "Obtenir de l'aide en cas de blocage" } },
            { "value": "eutxo-design", "text": { "default": "Designing for eUTxO (state, concurrency)", "fr": "Concevoir pour l'eUTxO (état, concurrence)" } },
            { "value": "minimum-ada", "text": { "default": "Minimum ada in each output (micropayments, airdrops)", "fr": "Le minimum d'ada par sortie (micropaiements, airdrops)" } },
