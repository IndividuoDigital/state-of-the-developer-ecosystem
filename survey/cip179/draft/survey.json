          "choices": [
            { "value": "Aicone, with Sundae multisig (Aiken)", "text": { "default": "Aicone, with Sundae multisig (Aiken)", "fr": "Aicone, avec Sundae multisig (Aiken)" } },
            "ak-381 (Aiken)",
