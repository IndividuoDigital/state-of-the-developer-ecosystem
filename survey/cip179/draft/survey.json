            "catalyst-onchain-libs (Plutarch)",
            "Liqwid libs (Plutarch)",
            "Ply (Plutarch)",
            "Design Patterns (Scalus)",
            { "value": "other", "text": { "default": "Other", "fr": "Autre" } }
