            { "value": "libraries", "text": { "default": "Incomplete or unmaintained libraries", "fr": "Bibliothèques incomplètes ou non maintenues" } },
            { "value": "breaking-changes", "text": { "default": "Breaking changes in tools and libraries", "fr": "Changements incompatibles des outils et bibliothèques" } },
            { "value": "chain-data", "text": { "default": "Getting chain data (indexers, APIs)", "fr": "Obtenir les données de la chaîne (indexeurs, API)" } },
            { "value": "api-limits", "text": { "default": "Limits and pricing of hosted APIs", "fr": "Limites et tarifs des API hébergées" } },
            { "value": "infrastructure", "text": { "default": "Running infrastructure (node, indexer)", "fr": "Faire tourner l'infrastructure (nœud, indexeur)" } },
            { "value": "ai", "text": { "default": "Getting good results from AI tools on Cardano code", "fr": "Obtenir de bons résultats des outils d'IA sur du code Cardano" } }
          ]
        },
