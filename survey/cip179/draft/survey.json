            { "value": "by-hand", "text": { "default": "By hand, with a wallet or the command line", "fr": "À la main, avec un portefeuille ou en ligne de commande" } },
            { "value": "formal-verification", "text": { "default": "Formal verification", "fr": "Vérification formelle" } },
            { "value": "audit", "text": { "default": "Audit by another team", "fr": "Audit par une autre équipe" } },
            { "value": "other", "text": { "default": "Other", "fr": "Autre" } }
          ],
          "showNoneItem": true,
          "noneText": {
            "default": "None",
            "fr": "Aucun"
          }
        },
        {
          "type": "text",
          "name": "missing_tools",
          "title": {
            "default": "Which tools do you use that are missing from the lists above?",
            "fr": "Quels outils utilisez-vous qui manquent dans les listes ci-dessus\u00a0?"
          }
        },
        {
          "type": "radiogroup",
          "name": "ai_frequency",
          "title": {
            "default": "In the past month, how often did you use AI coding tools for Cardano work?",
            "fr": "Au cours du dernier mois, à quelle fréquence avez-vous utilisé des outils d'IA pour coder sur Cardano\u00a0?"
          },
          "choices": [
            { "value": "daily", "text": { "default": "Daily or nearly so", "fr": "Tous les jours ou presque" } },
            { "value": "weekly", "text": { "default": "Weekly or nearly so", "fr": "Toutes les semaines ou presque" } },
            { "value": "less", "text": { "default": "Less often", "fr": "Moins souvent" } },
            { "value": "never", "text": { "default": "Never", "fr": "Jamais" } }
