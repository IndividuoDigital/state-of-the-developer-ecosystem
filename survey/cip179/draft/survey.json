        {
          "type": "text",
          "name": "ai_worst",
          "visibleIf": "{ai_frequency} <> 'never'",
          "title": {
            "default": "Which Cardano language, library or tool does AI handle worst, and what goes wrong?",
            "fr": "Quel langage, bibliothèque ou outil Cardano l'IA maîtrise-t-elle le moins bien, et qu'est-ce qui ne va pas\u00a0?"
          }
        }
      ]
