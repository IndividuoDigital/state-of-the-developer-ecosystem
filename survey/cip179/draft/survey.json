            { "value": "SPO scripts (gitmachtl)", "text": { "default": "SPO scripts (gitmachtl)", "fr": "Scripts SPO (gitmachtl)" } },
            "txtop",
            { "value": "other", "text": { "default": "Other", "fr": "Autre" } }
