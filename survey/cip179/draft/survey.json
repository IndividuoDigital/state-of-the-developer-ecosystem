          }
        },
        {
          "type": "checkbox",
          "name": "dev_tools",
          "title": {
            "default": "Which developer tools have you used in the last 12 months?",
            "fr": "Quels outils de développement avez-vous utilisés au cours des 12 derniers mois\u00a0?"
