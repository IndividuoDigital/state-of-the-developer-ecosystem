{
  "title": {
    "default": "Cardano Developer Survey 2026",
    "fr": "Enquête 2026 auprès des développeurs Cardano"
  },
  "description": {
    "default": "About 15 minutes. The results tell tool builders, documentation writers and funders what to work on first.",
    "fr": "Environ 15 minutes. Les résultats montrent aux créateurs d'outils, aux auteurs de documentation et aux financeurs sur quoi travailler en priorité."
  },
  "triggers": [{ "type": "complete", "expression": "{experience} = 'not-a-developer'" }],
  "pages": [
    {
      "name": "what_you_build",
      "elements": [
        {
          "type": "radiogroup",
          "name": "experience",
          "title": {
            "default": "How long have you been writing or deploying software?",
            "fr": "Depuis combien de temps écrivez-vous ou déployez-vous des logiciels\u00a0?"
          },
          "isRequired": true,
          "choices": [
            { "value": "not-a-developer", "text": { "default": "I don't write or deploy software", "fr": "Je n'écris ni ne déploie de logiciels" } },
            { "value": "under-2", "text": { "default": "Less than 2 years", "fr": "Moins de 2 ans" } },
            { "value": "2-4", "text": { "default": "2 to 4 years", "fr": "2 à 4 ans" } },
            { "value": "5-9", "text": { "default": "5 to 9 years", "fr": "5 à 9 ans" } },
            { "value": "10-plus", "text": { "default": "10 years or more", "fr": "10 ans ou plus" } }
          ]
        },
        {
          "type": "checkbox",
          "name": "building",
          "title": {
            "default": "What are you building on Cardano?",
            "fr": "Que développez-vous sur Cardano\u00a0?"
          },
          "description": {
            "default": "Choose up to 4.",
            "fr": "Choisissez-en jusqu'à 4."
          },
          "maxSelectedChoices": 4,
          "choices": [
            { "value": "ai-agents", "text": { "default": "AI agents", "fr": "Agents d'IA" } },
            { "value": "bridges", "text": { "default": "Bridges and interoperability", "fr": "Ponts et interopérabilité" } },
            { "value": "defi", "text": "DeFi" },
            { "value": "dev-tools", "text": { "default": "Developer tools and infrastructure", "fr": "Outils de développement et infrastructure" } },
            { "value": "education", "text": { "default": "Education and community", "fr": "Éducation et communauté" } },
            { "value": "gaming", "text": { "default": "Gaming", "fr": "Jeux" } },
            { "value": "governance", "text": { "default": "Governance tools", "fr": "Outils de gouvernance" } },
            { "value": "identity", "text": { "default": "Identity", "fr": "Identité" } },
            { "value": "layer-2", "text": { "default": "Layer 2s and scaling", "fr": "Layer 2 et passage à l'échelle" } },
            { "value": "nfts", "text": { "default": "NFTs", "fr": "NFT" } },
            { "value": "oracles", "text": { "default": "Oracles and data", "fr": "Oracles et données" } },
            { "value": "payments", "text": { "default": "Payments and stablecoins", "fr": "Paiements et stablecoins" } },
            { "value": "privacy", "text": { "default": "Privacy and zero-knowledge", "fr": "Confidentialité et zero-knowledge" } },
            { "value": "real-world-assets", "text": { "default": "Real-world assets", "fr": "Actifs du monde réel" } },
            { "value": "staking", "text": { "default": "Staking and SPO tools", "fr": "Staking et outils pour SPO" } },
            { "value": "wallets", "text": { "default": "Wallets", "fr": "Portefeuilles" } },
            { "value": "other", "text": { "default": "Other", "fr": "Autre" } }
          ]
        },
        {
          "type": "radiogroup",
          "name": "stage",
          "title": {
            "default": "How far along is your main Cardano project?",
            "fr": "Où en est votre principal projet Cardano\u00a0?"
          },
          "choices": [
            { "value": "learning", "text": { "default": "Learning or experimenting", "fr": "Apprentissage ou expérimentation" } },
            { "value": "development", "text": { "default": "In development (testnet)", "fr": "En développement (testnet)" } },
            { "value": "released", "text": { "default": "Released (mainnet, or a published tool)", "fr": "Lancé (mainnet, ou outil publié)" } },
            { "value": "users", "text": { "default": "Released, with regular users", "fr": "Lancé, et utilisé régulièrement" } }
          ]
        },
        {
          "type": "text",
          "name": "project_link",
          "visibleIf": "{stage} anyof ['released', 'users']",
          "title": {
            "default": "Where can we find this project (website or repository link)?",
            "fr": "Où peut-on trouver ce projet (lien vers le site web ou le dépôt)\u00a0?"
          },
          "description": {
            "default": "This link is public and ties all your answers to this project.",
            "fr": "Ce lien est public et associe toutes vos réponses à ce projet."
          }
        },
        {
          "type": "radiogroup",
          "name": "started",
          "title": {
            "default": "When did you start building on Cardano?",
            "fr": "Quand avez-vous commencé à développer sur Cardano\u00a0?"
          },
          "choices": [
            "2026",
            "2025",
            { "value": "2023-2024", "text": "2023–2024" },
            { "value": "2021-2022", "text": "2021–2022" },
            { "value": "2020-or-earlier", "text": { "default": "2020 or earlier", "fr": "2020 ou avant" } }
          ]
        },
        {
          "type": "radiogroup",
          "name": "weekly_hours",
          "title": {
            "default": "In a typical week, how much time do you spend building on Cardano?",
            "fr": "Lors d'une semaine type, combien de temps passez-vous à développer sur Cardano\u00a0?"
          },
          "choices": [
            { "value": "under-5", "text": { "default": "Less than 5 hours", "fr": "Moins de 5 heures" } },
            { "value": "5-19", "text": { "default": "5 to 19 hours", "fr": "5 à 19 heures" } },
            { "value": "20-34", "text": { "default": "20 to 34 hours", "fr": "20 à 34 heures" } },
            { "value": "35-plus", "text": { "default": "35 hours or more", "fr": "35 heures ou plus" } }
          ]
        }
      ]
    },
    {
      "name": "how_it_is_going",
      "elements": [
        {
          "type": "radiogroup",
          "name": "satisfaction",
          "title": {
            "default": "Overall, how satisfied are you with building on Cardano?",
            "fr": "Dans l'ensemble, comment jugez-vous votre expérience de développement sur Cardano\u00a0?"
          },
          "choices": [
            { "value": "very-satisfied", "text": { "default": "Very satisfied", "fr": "Très satisfaisante" } },
            { "value": "satisfied", "text": { "default": "Satisfied", "fr": "Satisfaisante" } },
            { "value": "neutral", "text": { "default": "Neither satisfied nor dissatisfied", "fr": "Ni satisfaisante ni insatisfaisante" } },
            { "value": "dissatisfied", "text": { "default": "Dissatisfied", "fr": "Insatisfaisante" } },
            { "value": "very-dissatisfied", "text": { "default": "Very dissatisfied", "fr": "Très insatisfaisante" } }
          ]
        },
        {
          "type": "radiogroup",
          "name": "trend",
          "title": {
            "default": "Compared with a year ago, building on Cardano is:",
            "fr": "Par rapport à il y a un an, développer sur Cardano est\u00a0:"
          },
          "choices": [
            { "value": "much-easier", "text": { "default": "Much easier", "fr": "Beaucoup plus facile" } },
            { "value": "easier", "text": { "default": "Somewhat easier", "fr": "Un peu plus facile" } },
            { "value": "same", "text": { "default": "About the same", "fr": "À peu près pareil" } },
            { "value": "harder", "text": { "default": "Somewhat harder", "fr": "Un peu plus difficile" } },
            { "value": "much-harder", "text": { "default": "Much harder", "fr": "Beaucoup plus difficile" } },
            { "value": "new", "text": { "default": "I wasn't building on Cardano a year ago", "fr": "Je ne développais pas sur Cardano il y a un an" } }
          ]
        },
        {
          "type": "comment",
          "name": "best",
          "title": {
            "default": "What is the best thing about building on Cardano?",
            "fr": "Quel est le meilleur aspect du développement sur Cardano\u00a0?"
          }
        },
        {
          "type": "comment",
          "name": "most_painful",
          "title": {
            "default": "What is the most painful thing about building on Cardano?",
            "fr": "Quel est l'aspect le plus pénible du développement sur Cardano\u00a0?"
          }
        }
      ]
    },
    {
      "name": "what_you_build_with",
      "elements": [
        {
          "type": "checkbox",
          "name": "onchain_languages",
          "title": {
            "default": "Which languages have you used for on-chain code in the last 12 months?",
            "fr": "Quels langages avez-vous utilisés pour du code on-chain au cours des 12 derniers mois\u00a0?"
          },
          "choices": [
            "Aiken",
            "Helios",
            "JuLC",
            "Marlowe",
            "OpShin",
            "Pebble",
            "Plinth (Plutus-Tx)",
            "Plu-ts",
            "Plutarch",
            "Scalus",
            { "value": "other", "text": { "default": "Other", "fr": "Autre" } }
          ],
          "showNoneItem": true,
          "noneText": {
            "default": "None, I don't write on-chain code",
            "fr": "Aucun, je n'écris pas de code on-chain"
          }
        },
        {
          "type": "checkbox",
          "name": "onchain_libraries",
          "title": {
            "default": "Which on-chain libraries have you used in the last 12 months?",
