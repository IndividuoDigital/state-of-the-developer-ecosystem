        },
        {
          "type": "checkbox",
          "name": "hosted_apis",
          "title": {
            "default": "Which hosted API services have you used in the last 12 months?",
            "fr": "Quels services d'API hébergés avez-vous utilisés au cours des 12 derniers mois\u00a0?"
