            "nview",
            "offchain-metadata-tools",
            "Sorbet",
            "SPO scripts (gitmachtl)",
            "txtop",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "checkbox",
          "name": "hosted_apis",
          "title": "Which hosted API services have you used in the last 12 months?",
          "choices": [
            "AdaStat",
            "Blockfrost",
            "Cardanoscan",
            "Cexplorer",
            "Charli3",
            "Demeter",
            "Dune",
            "IAG Insight",
            "Koios",
            "Maestro",
            "Nexus",
            "NMKR",
            "Orcfax",
            "Pyth",
            "SteelSwap",
            "TapTools",
            "Token registry",
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "checkbox",
          "name": "testing",
          "title": "How have you tested your Cardano code in the last 12 months?",
          "choices": [
            { "value": "unit", "text": "Unit tests of validators" },
            { "value": "property", "text": "Property-based tests or fuzzing" },
            { "value": "emulator", "text": "Emulator, no node (Lucid Evolution, Scalus, sc-tools…)" },
            { "value": "devnet", "text": "Local devnet (Yaci DevKit, cardano-testnet…)" },
            { "value": "testnet", "text": "Public testnet (Preview, Preprod)" },
            { "value": "mainnet", "text": "Mainnet, with small amounts" },
            { "value": "by-hand", "text": "By hand, with a wallet or the command line" },
            { "value": "formal-verification", "text": "Formal verification" },
            { "value": "audit", "text": "Audit by another team" },
            { "value": "other", "text": "Other" }
          ],
          "showNoneItem": true
        },
        {
          "type": "text",
          "name": "missing_tools",
          "title": "Which tools do you use that are missing from the lists above?"
        },
        {
          "type": "radiogroup",
          "name": "ai_frequency",
          "title": "In the past month, how often did you use AI coding tools for Cardano work?",
          "choices": [
            { "value": "daily", "text": "Daily or nearly so" },
            { "value": "weekly", "text": "Weekly or nearly so" },
            { "value": "less", "text": "Less often" },
            { "value": "never", "text": "Never" }
          ]
        },
        {
          "type": "text",
          "name": "ai_worst",
          "visibleIf": "{ai_frequency} <> 'never'",
          "title": "Which Cardano language, library or tool does AI handle worst, and what goes wrong?"
        }
      ]
    },
    {
      "name": "what_gets_in_the_way",
      "elements": [
        {
          "type": "matrix",
          "name": "problems",
          "title": "How much of a problem is each of these for you?",
          "columns": [
            { "value": "big", "text": "Big problem for me" },
            { "value": "could-be-better", "text": "Could be better, doesn't limit me" },
            { "value": "good", "text": "Good for me" },
            { "value": "not-relevant", "text": "Not relevant to me" }
          ],
          "rows": [
            { "value": "first-app", "text": "Getting a first application working end to end" },
            { "value": "choosing-tools", "text": "Knowing which tools and libraries to choose" },
            { "value": "documentation", "text": "Finding up-to-date documentation" },
            { "value": "examples", "text": "Finding working examples" },
            { "value": "help", "text": "Getting help when I am stuck" },
            { "value": "eutxo-design", "text": "Designing for eUTxO (state, concurrency)" },
            { "value": "minimum-ada", "text": "Minimum ada in each output (micropayments, airdrops)" },
            { "value": "building-transactions", "text": "Building transactions" },
            { "value": "wallets", "text": "Connecting to wallets (CIP-30 issues, mobile wallets)" },
            { "value": "testing", "text": "Testing validators" },
            { "value": "debugging", "text": "Debugging validators" },
            { "value": "libraries", "text": "Incomplete or unmaintained libraries" },
            { "value": "breaking-changes", "text": "Breaking changes in tools and libraries" },
            { "value": "chain-data", "text": "Getting chain data (indexers, APIs)" },
            { "value": "api-limits", "text": "Limits and pricing of hosted APIs" },
            { "value": "infrastructure", "text": "Running infrastructure (node, indexer)" },
            { "value": "ai", "text": "Getting good results from AI tools on Cardano code" }
          ]
        },
        {
          "type": "checkbox",
          "name": "answer_sources",
          "title": "Where do you get answers to technical questions about Cardano?",
          "description": "Choose up to 5, the ones you rely on most.",
          "maxSelectedChoices": 5,
          "choices": [
            { "value": "ai", "text": "AI assistants" },
            { "value": "blogs", "text": "Blogs and articles" },
            "Cardano Blueprint",
            { "value": "cardano-docs", "text": "Cardano docs (docs.cardano.org)" },
