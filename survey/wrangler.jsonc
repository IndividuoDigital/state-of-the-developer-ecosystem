/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "state-of-cardano-developer-survey-2025",
  "compatibility_date": "2025-09-27",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  /* The sponsor's state (cip179/sponsor-store.js). Create it with
     `wrangler d1 create cip179-sponsor`, put its id here, then
     `yarn db:migrate --remote`. */
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cip179-sponsor",
      "database_id": "not-created-yet",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    /* Always pass */
    "state-of-the-developer-ecosystem-2025-turnstile": "1x0000000000000000000000000000000AA",
    /* Always fail */
    /* "state-of-the-developer-ecosystem-2025-turnstile": "2x0000000000000000000000000000000AA" */
    /* The sponsor (cip179/sponsor.js); its SPONSOR_MNEMONIC is a secret. */
    "SPONSOR_NETWORK": "preview",
    "SPONSOR_KOIOS": "https://preview.koios.rest/api/v1",
    "SPONSOR_SURVEY": "70928d2c8cca0fa616e8df54a54d5c311deeec354f5a261fa6c1009ffde89aa5#0"
  }
}
