/**
 * The Cloudflare Pages project: `yarn wrangler pages deploy` deploys `dist/`
 * with these bindings and vars. See the README's deployment steps.
 * https://developers.cloudflare.com/pages/functions/wrangler-configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "state-of-cardano-developer-survey-2026",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2025-09-27",
  /* The sponsor's state (cip179/sponsor-store.js), one database per network. */
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cip179-sponsor-preview",
      "database_id": "3f5042f0-98ec-4eb2-9072-8421eda29a0c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    /* The Turnstile widget of the site's hostname. Its TURNSTILE_SECRET is a
       secret; locally, the test secret in .dev.vars. */
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYzWeyCVNJMl0nI",
    /* The sponsor (cip179/sponsor.js); its SPONSOR_MNEMONIC is a secret. */
    "SPONSOR_NETWORK": "preview",
    "SPONSOR_KOIOS": "https://preview.koios.rest/api/v1",
    "SPONSOR_SURVEY": "1c48bbd663d2304330589c1342f7731c8a4069ad2a2aed2c5f4e485e1b42e7bc#0"
  }
}
